{
  "name": "dabingli",
  "version": "2.0.0",
  "private": true,
  "description": "大病历生成器 —— 离线单文件网页，把问诊与查体整理成规范大病历",
  "scripts": {
    "build": "node build.js",
    "test": "node --test tests/*.test.cjs",
    "test:core": "node --test tests/core.test.cjs",
    "test:ui": "node --test tests/app.test.cjs",
    "coverage": "node --experimental-test-coverage --test --test-coverage-include=src/core.js --test-coverage-include=src/generator.js --test-coverage-include=src/hints.js tests/core.test.cjs tests/generator.test.cjs",
    "verify": "node build.js && node --test tests/*.test.cjs",
    "samples": "node test/samples.js",
    "e2e:browser": "node test/browser-check.js",
    "e2e:file": "node test/file-scenario.js"
  },
  "engines": {
    "node": ">=22"
  }
}
