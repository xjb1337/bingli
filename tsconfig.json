{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "packages/domain/src/**/*.ts",
    "packages/domain/src/**/*.d.ts"
  ],
  "exclude": [
    "packages/domain/src/template-data.ts",
    "packages/domain/dist",
    "node_modules"
  ]
}
